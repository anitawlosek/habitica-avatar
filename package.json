{
  "name": "habitica-avatar",
  "version": "0.2.0",
  "description": "A module for constructing the Habitica avatar.",
  "main": "habitica-avatar.js",
  "files": [
    "habitica-avatar.js",
    "lib/*.js"
  ],
  "scripts": {
    "build": "browserify -s habiticaAvatar ./habitica-avatar.js > dist/habitica-avatar.js",
    "build:demo": "browserify docs/src/index.js > docs/script.js && browserify docs/src/avatar.js > docs/avatar-script.js",
    "lint": "standard --verbose | snazzy",
    "server": "http-server -p3003 docs",
    "start": "npm run server",
    "pretest": "npm run lint",
    "test": "mocha test --recursive",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [],
  "author": "Anita Bielaszewska-Wlosek <anitawlosek@gmail.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/anitawlosek/habitica-avatar.git"
  },
  "bugs": {
    "url": "https://github.com/anitawlosek/habitica-avatar/issues"
  },
  "homepage": "https://github.com/anitawlosek/habitica-avatar#readme",
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.1",
    "@storybook/addon-a11y": "^9.1.7",
    "@storybook/addon-docs": "^9.1.7",
    "@storybook/addon-vitest": "^9.1.7",
    "@storybook/react-vite": "^9.1.7",
    "browserify": "^16.2.3",
    "chai": "^4.2.0",
    "http-server": "^0.11.1",
    "mocha": "^6.1.4",
    "prop-types": "^15.8.1",
    "sinon": "^7.3.2",
    "sinon-chai": "^3.3.0",
    "snazzy": "^8.0.0",
    "standard": "^12.0.1",
    "storybook": "^9.1.7",
    "vitest": "^3.2.4",
    "@vitest/browser": "^3.2.4",
    "playwright": "^1.55.0",
    "@vitest/coverage-v8": "^3.2.4"
  },
  "standard": {
    "globals": [
      "afterEach",
      "beforeEach",
      "it",
      "describe",
      "expect",
      "makeFakeDomElement",
      "sandbox",
      "xit"
    ],
    "ignore": [
      "dist/",
      "docs/*.js"
    ]
  },
  "dependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
